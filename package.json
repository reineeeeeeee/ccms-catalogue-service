{
  "name": "ccms-core-service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "ccms": {
    "service": "core",
    "port": 3003
  },
  "scripts": {
    "dev": "next dev -p 3003",
    "build": "next build",
    "start": "next start -p 3003",
    "lint": "eslint .",
    "check:time": "ccms-check-time src scripts mocks",
    "test": "node --test \"test/**/*.test.js\" && npm run test:engine:tz",
    "test:engine:tz": "node scripts/test-engine-tz.mjs",
    "db:sync": "node --env-file-if-exists=.env.local scripts/sync-db.js",
    "seed": "node --env-file-if-exists=.env.local scripts/seed.js",
    "seed:holidays": "node --env-file-if-exists=.env.local scripts/seed-holidays.js",
    "mocks": "node --env-file-if-exists=.env.local mocks/index.js",
    "ci": "npm run lint && npm run check:time && npm test && npm run build",
    "migrate": "node --env-file-if-exists=.env.local scripts/migrate.js"
  },
  "dependencies": {
    "ccms-shared": "file:./vendor/ccms-shared",
    "jose": "^6.2.0",
    "next": "^16.3.0",
    "pg": "^8.13.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typeorm": "^0.3.20"
  },
  "devDependencies": {
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.3.0"
  }
}
